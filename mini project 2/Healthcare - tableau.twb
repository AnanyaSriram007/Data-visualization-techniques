      <aliases enabled='yes' />
      <column aggregation='Count' caption='Admission Date' datatype='date' datatype-customized='true' name='[Admission_Date]' role='dimension' type='ordinal' />
      <column caption='Insurance Paid Percentage' datatype='real' name='[Calculation_0749087393996800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Insurance_Coverage] / [Treatment_Cost]) * 100' />
      </column>
      <column caption='Stay Category' datatype='string' name='[Calculation_0749087394349057]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Length_of_Stay] &lt;= 3 THEN &quot;Short Stay&quot;&#13;&#10;ELSEIF [Length_of_Stay] &lt;= 7 THEN &quot;Medium Stay&quot;&#13;&#10;ELSE &quot;Long Stay&quot;&#13;&#10;END' />
      </column>
      <column caption='Selected Healthcare Metric' datatype='real' name='[Calculation_0749087401906181]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0749087401512964]&#13;&#10;WHEN &quot;Treatment Cost&quot; THEN [Treatment_Cost]&#13;&#10;WHEN &quot;Insurance Coverage&quot; THEN [Insurance_Coverage]&#13;&#10;WHEN &quot;Patient Payment&quot; THEN [Patient_Payment]&#13;&#10;END' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column aggregation='Count' caption='Discharge Date' datatype='date' datatype-customized='true' name='[Discharge_Date]' role='dimension' type='ordinal' />
