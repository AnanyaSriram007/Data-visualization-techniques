      <column caption='Profit Status' datatype='string' name='[Calculation_1639691806105601]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &gt; 0 THEN &quot;Profitable&quot;&#13;&#10;ELSE &quot;Loss&quot;&#13;&#10;END' />
      </column>
      <column caption='Selected Financial Metric' datatype='real' name='[Calculation_1639691817451527]' role='measure' type='quantitative'>
